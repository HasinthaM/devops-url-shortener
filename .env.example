# Application Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000

# Security & CORS
# Use explicit origins in production (e.g. https://app.example.com); '*' is rejected when NODE_ENV=production
CORS_ORIGIN=*
# Reverse-proxy hops to trust for X-Forwarded-For (0 if exposed directly)
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CREATE_RATE_LIMIT_MAX=20

# Management Authentication (Required for URL deletion/management)
# Must be >= 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public

# Logging Configuration
# Levels: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

