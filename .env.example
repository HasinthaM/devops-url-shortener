# Application Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000

# Security & CORS
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CREATE_RATE_LIMIT_MAX=20

# Management Authentication (Required for URL deletion/management)
ADMIN_API_KEY=dev-secret-admin-key-change-in-production

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public

# Logging Configuration
# Levels: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

